{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "types": [
      "node",
      "express",
      "bcryptjs",
      "compression",
      "cors",
      "jsonwebtoken",
      "morgan",
      "multer",
      "supertest"
    ]
  },
  "include": ["src/**/*", "server.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
